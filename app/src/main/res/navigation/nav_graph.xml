<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.coincompass.ui.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_budgets"
        android:name="com.example.coincompass.ui.fragments.BudgetsFragment"
        android:label="Budget"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/nav_analytics"
        android:name="com.example.coincompass.ui.fragments.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics">
        <argument
            android:name="startDate"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="endDate"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/nav_savings"
        android:name="com.example.coincompass.ui.fragments.SavingsFragment"
        android:label="Savings"
        tools:layout="@layout/fragment_savings" />

    <fragment
        android:id="@+id/nav_transactions"
        android:name="com.example.coincompass.ui.fragments.TransactionsFragment"
        android:label="Transactions"
        tools:layout="@layout/fragment_transactions" />

    <fragment
        android:id="@+id/nav_calendar"
        android:name="com.example.coincompass.ui.fragments.CalendarFragment"
        android:label="Calendar"
        tools:layout="@layout/fragment_calendar" />

    <fragment
        android:id="@+id/nav_more"
        android:name="com.example.coincompass.ui.fragments.MoreFragment"
        android:label="More"
        tools:layout="@layout/fragment_more" />

</navigation>
