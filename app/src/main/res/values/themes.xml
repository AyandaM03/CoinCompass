<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CoinCompass" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/soft_mint</item>
        <item name="colorOnPrimaryContainer">@color/primary_green</item>

        <item name="colorSecondary">@color/gold_accent</item>
        <item name="colorOnSecondary">@color/primary_green</item>
        <item name="colorSecondaryContainer">@color/soft_mint</item>
        <item name="colorOnSecondaryContainer">@color/primary_green</item>

        <item name="colorTertiary">@color/secondary_green</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="android:windowBackground">@color/background_off_white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="colorSurfaceVariant">@color/light_grey</item>
        <item name="colorOnSurfaceVariant">@color/dark_text</item>

        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:editTextColor">@color/black</item>

        <!-- Force consistent background and remove Material 3 defaults that might look pink -->
        <item name="colorOutline">@color/text_grey</item>
        <item name="colorOutlineVariant">@color/light_grey</item>
        <item name="colorError">@color/expense_red</item>

        <!-- Global Text Field Styling (Removes Purple) -->
        <item name="colorControlActivated">@color/primary_green</item>
        <item name="colorControlHighlight">@color/soft_mint</item>
        <item name="android:textCursorDrawable">@null</item>

        <!-- Selection handles and highlighting -->
        <item name="android:textColorHighlight">@color/soft_mint</item>
    </style>

    <style name="Theme.CoinCompass" parent="Base.Theme.CoinCompass" />

    <!-- Custom Styles for UI Components -->
    <style name="FintechCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="FintechButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="backgroundTint">@color/primary_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">@color/gold_accent</item>
    </style>

    <style name="FintechButton.Secondary" parent="FintechButton">
        <item name="backgroundTint">@color/gold_accent</item>
        <item name="android:textColor">@color/primary_green</item>
    </style>

    <style name="FintechHeader" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_green</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="FintechSubHeader" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_grey</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="CalendarHeaderStyle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/primary_green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Global Styled TextInputLayout (M3 OutlinedBox) -->
    <style name="FintechInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_stroke_color</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_grey</item>
        <item name="android:textColorHint">@color/text_grey</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="cursorColor">@color/primary_green</item>
    </style>

</resources>
