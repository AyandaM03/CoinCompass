<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Boost Your Goal"
        style="@style/FintechSubHeader"
        android:textColor="@color/primary_green"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.card.MaterialCardView
        style="@style/FintechCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/cream_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/FintechInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Amount to Add"
                app:prefixText="R "
                app:startIconDrawable="@drawable/ic_add"
                app:startIconTint="@color/primary_green">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/add_funds_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
