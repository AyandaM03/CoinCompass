<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_off_white">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transactions"
                style="@style/FintechHeader"
                android:textColor="@color/primary_green"
                android:textSize="28sp" />

            <!-- Search Bar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_layout"
                style="@style/FintechInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:hintEnabled="false"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:startIconTint="@color/primary_green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search transactions"
                    android:textColorHint="@color/text_grey"
                    android:paddingVertical="12dp"
                    android:textColor="@color/black"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Filter Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- Row 1: Type Filters -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/type_chip_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_all"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="All"
                        android:checked="true"
                        android:textAlignment="center"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeColor="@color/primary_green"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/chip_text_selector" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_income"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Income"
                        android:textAlignment="center"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeColor="@color/primary_green"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/chip_text_selector" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_expense"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Expenses"
                        android:textAlignment="center"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeColor="@color/primary_green"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/chip_text_selector" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Row 2: Date Filters -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/date_chip_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_today"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Today"
                        android:textAlignment="center"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeColor="@color/primary_green"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/chip_text_selector" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_month"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="This Month"
                        android:textAlignment="center"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeColor="@color/primary_green"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/chip_text_selector" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_range"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="Custom Range"
                        android:textAlignment="center"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeColor="@color/primary_green"
                        app:chipStrokeWidth="1dp"
                        android:textColor="@color/chip_text_selector"
                        app:chipIcon="@drawable/ic_calendar"
                        app:chipIconTint="@color/chip_text_selector" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_off_white"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="100dp">

            <include
                android:id="@+id/empty_state"
                layout="@layout/layout_empty_state" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/transactions_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                tools:listitem="@layout/item_expense" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_transaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary_green"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
